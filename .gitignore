# --- Audio working files --------------------------------------------------
# The four delivered stems live in assets/ and ARE tracked. Everything below
# is intermediate: DAW sessions, bounces, scratch renders and waveform caches.
#
# Convention: put anything you are still working on under a working/ or _wip/
# folder and it stays out of the repo.
working/
_wip/
bounces/
renders/
scratch/
assets/**/working/
assets/**/_wip/

# DAW project and session files
*.als
*.alp
*.flp
*.rpp
*.rpp-bak
*.logicx
*.ptx
*.ptf
*.aup
*.aup3
*.band
*.cpr
*.npr
*.song
*.sesx
*.reason
*.RPP

# Waveform / peak / analysis caches
*.asd
*.reapeaks
*.sfk
*.pkf
*.peak
*.otio
*.aup3-wal
*.aup3-shm

# Uncompressed intermediates and raw captures. Delivered stems are added
# explicitly with `git add -f assets/<name>.wav` if they match these.
*.rf64
*.w64
*.caf
*.pcm
*.raw
*_render.wav
*_bounce.wav
*_scratch.wav
*-take[0-9]*.wav

