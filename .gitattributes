# Fixtures are compared byte for byte against what the recorder writes today.
# Never convert their line endings on checkout, whatever core.autocrlf says.
tools/fixtures/** -text

# The committed engine library is checked against its SHA-256 (vendor/lib/README.md).
# Never let any line-ending or diff setting touch it.
vendor/lib/*.dll binary

# Git for Windows executes hooks through its POSIX shell.
.githooks/* text eol=lf
